<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <Appenders>
        <Console name="LogToConsole" target="SYSTEM_OUT">
            <JsonTemplateLayout eventTemplateUri="classpath:log-schema.json" />
        </Console>
    </Appenders>

    <Loggers>
        <Logger name="io.meshk.milton" level="info" additivity="false">
            <AppenderRef ref="LogToConsole" />
            <level value="all"/>
        </Logger>

        <Root level="info">
            <AppenderRef ref="LogToConsole" />
        </Root>
    </Loggers>
</configuration>